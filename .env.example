# Keyless, local sample configuration. Keep all emulators off in cloud deployments.
NEXT_PUBLIC_DEMO_MODE=1
NEXT_PUBLIC_FIREBASE_API_KEY=demo-learning-studio-public-config
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-learning-studio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-learning-studio
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:learningstudio
FIREBASE_PROJECT_ID=demo-learning-studio
FIREBASE_STORAGE_BUCKET=demo-learning-studio.appspot.com
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Set gemini with GEMINI_API_KEY to test live AI on the local sample project.
AI_PROVIDER=demo

# Cloud only. Set NEXT_PUBLIC_DEMO_MODE=0 and AI_PROVIDER=gemini and remove the emulator variables above.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GEMINI_API_KEY=
# Legacy names are the required environment interface. These are Gemini model IDs.
OPENAI_CHAT_MODEL=gemini-3.1-flash-lite
OPENAI_EMBED_MODEL=gemini-embedding-001

# Optional. Preview mode rejects admin actions and any live AI calls.
# DEMO_PUBLIC_PREVIEW=1
# AI_DAILY_LIMIT=40
# APP_BASE_URL=http://127.0.0.1:3000
